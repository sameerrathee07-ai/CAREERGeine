# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Firebase Admin ──────────────────────────────────
# Option A: Path to service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Option B: Inline credentials (used if GOOGLE_APPLICATION_CREDENTIALS is empty)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Email (Nodemailer SMTP) ─────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=CareerGenie <noreply@careergenie.ai>

# ─── Known Skills (comma-separated, for NLP) ──────
KNOWN_SKILLS=JavaScript,TypeScript,Python,Java,React,Node.js,SQL,MongoDB,AWS,Docker,Go,Rust,C++,Git,Linux,Agile,REST API,GraphQL,Redis,Kubernetes,CI/CD,TensorFlow,PyTorch,Angular,Vue.js,Express.js,PostgreSQL,Firebase,GCP,Azure,HTML,CSS,Sass,Webpack,Babel,Jest,React Native,Flutter,Django,Spring Boot,.NET,Flask,FastAPI,Next.js,Nuxt.js,Tailwind CSS

# ─── OpenAI (AI-Powered Features) ───────────────────
# Enable AI resume parsing, analysis, job matching, career assistant, recruiter AI
# Without this key, all AI features degrate gracefully to NLP-based fallbacks
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ─── Rate Limiting ──────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
